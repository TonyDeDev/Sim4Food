# Neon Postgres connection string (same database backend/.env points at).
# Get it from the Neon dashboard's Connection Details - it already includes sslmode=require.
POSTGRES_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require


# Base URL of the Python (FastAPI) backend, once it is deployed. Set the same var in Vercel env vars.
NEXT_PUBLIC_API_URL=http://localhost:8000
