# Neon Postgres connection string (same database backend/.env points at).
# Get it from the Neon dashboard's Connection Details - it already includes sslmode=require.
POSTGRES_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require


# Base URL of the Python (FastAPI) backend. Read only by next.config.ts's
# rewrites() to proxy /py/* to it server-to-server - never sent to the
# browser, so it does NOT need a NEXT_PUBLIC_ prefix. Set the same var in
# Vercel env vars (Production/Preview), once the backend is deployed.
BACKEND_URL=http://localhost:8000
