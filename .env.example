# Copy to .env in the repo root. Never commit the real file (it is gitignored).

# REQUIRED. Neon Postgres connection string.
# Neon dashboard > your project > Connection Details. It already includes sslmode=require.
# Use the same value in backend/.env.
POSTGRES_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# REQUIRED for the app to reach the API. Base URL of the FastAPI backend.
# Read only by next.config.ts to proxy /py/* server-to-server, so it needs no NEXT_PUBLIC_ prefix.
# Locally this is http://localhost:8000. Set the deployed backend URL in Vercel env vars.
BACKEND_URL=http://localhost:8000
