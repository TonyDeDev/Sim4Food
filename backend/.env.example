# Copy to backend/.env. Paste the Neon connection string from the project's
# Neon dashboard (Connection Details) - it already includes sslmode=require.
POSTGRES_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# No longer required for the deployed app (the browser now reaches FastAPI
# only through the Next.js /py/* proxy, which isn't subject to CORS). Keep
# http://localhost:3000 here for local-dev convenience; add other origins
# only if something calls this backend directly and cross-origin.
CORS_ORIGINS=http://localhost:3000

# Snowflake Cortex for the AI order summary and chat (optional; the app works without it).
# Account identifier is <org>-<account>, e.g. app.snowflake.com/guvzzec/ss98777 -> guvzzec-ss98777.
# SNOWFLAKE_PAT is a programmatic access token (Snowsight: user menu > Settings > Authentication).
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_PAT=
CORTEX_MODEL=claude-sonnet-4-5
