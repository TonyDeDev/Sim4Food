# Copy to backend/.env. Never commit the real file (it is gitignored).

# REQUIRED. Neon connection string, same value as the root .env.
# Neon dashboard > your project > Connection Details. It already includes sslmode=require.
POSTGRES_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# OPTIONAL. No longer required for the deployed app (the browser now reaches FastAPI
# only through the Next.js /py/* proxy, which isn't subject to CORS). Keep
# http://localhost:3000 here for local-dev convenience; add other origins
# only if something calls this backend directly and cross-origin.
CORS_ORIGINS=http://localhost:3000

# OPTIONAL. Snowflake Cortex for the AI order summary and chat.
# Leave both values blank and the app works the same, the AI routes just return 503.
# See docs/snowflake-cortex.md for the full Snowflake-side setup.
# Account identifier is <org>-<account>, e.g. app.snowflake.com/<org>/<account> -> <org>-<account>.
# SNOWFLAKE_PAT is a programmatic access token (Snowsight: user menu > Settings > Authentication).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
CORTEX_MODEL=claude-sonnet-4-5
